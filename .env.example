# Domínio que vai apontar pra essa aplicação (configure o DNS antes!)
DOMAIN=cards.adapterco.com.br

# Segredo JWT — gere com: openssl rand -hex 32
JWT_SECRET=<cole-aqui-64-chars-hex-aleatorios>

# Chave de admin pra criar/listar/deletar tags via API — gere com: openssl rand -hex 24
ADMIN_KEY=<cole-aqui-48-chars-hex-aleatorios>

# MinIO (armazenamento de imagens — avatares, backgrounds, fotos de produto)
# Endpoint da API S3 do MinIO (sem barra no final)
MINIO_ENDPOINT=https://upload.adapterco.com.br
# Access/Secret — TODO: criar service account escopado no painel do MinIO em vez de usar a root
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
# Nome do bucket (deve ser PUBLIC pra leitura anônima)
MINIO_BUCKET=imagens
# URL pública de leitura: PUBLIC_URL/{key} é o que vai pro <img src>
MINIO_PUBLIC_URL=https://upload.adapterco.com.br/imagens

# E-mail para recuperação de senha (SMTP). Sem SMTP_HOST, os e-mails só aparecem no log do backend.
# Ex.: SMTP do seu provedor de e-mail, Brevo, Amazon SES, Resend (modo SMTP)...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (precisa ser um endereço autorizado no provedor)
SMTP_FROM="Adapter Cards <nao-responda@adapterco.com.br>"

# Backup do Mongo (serviço mongo-backup): dias de retenção e intervalo entre backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
